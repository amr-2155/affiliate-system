{
  "name": "affiliate-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx tsx --test __tests__/**/*.test.ts",
    "db:init": "npx tsx scripts/db-init.ts",
    "db:backup": "npx tsx scripts/backup-db.mts",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma db push --force-reset && npx tsx prisma/seed.ts",
    "db:generate:pg": "npx prisma generate --schema prisma/schema.postgresql.prisma",
    "db:generate:sqlite": "npx prisma generate --schema prisma/schema.prisma",
    "db:migrate:staging": "npx prisma migrate dev --schema prisma/schema.postgresql.prisma"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "prisma": "^6.9.0",
    "@prisma/client": "^6.9.0",
    "next-auth": "^4.24.14",
    "@auth/prisma-adapter": "^2.11.2",
    "zod": "^4.4.3",
    "bcryptjs": "^3.0.3",
    "zustand": "^5.0.14",
    "recharts": "^2.15.3",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bcryptjs": "^2.4.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
